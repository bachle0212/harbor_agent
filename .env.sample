# Copy to .env and fill in. Never commit real keys.
# Docker also accepts -e API_KEY=... as an alias for GEMINI_API_KEY.

GEMINI_API_KEY=
GOOGLE_API_KEY=
API_KEY=

# Optional after the first successful upload (also persisted in data/state.json).
GEMINI_FILE_SEARCH_STORE=

# Model used by: python -m harbor.ask "How do I add a YouTube video?"
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

ZENDESK_LOCALE=en-us
MIN_ARTICLES=30
SCRAPE_MIN_INTERVAL=0.5
SCRAPE_MAX_RETRIES=5
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=256
